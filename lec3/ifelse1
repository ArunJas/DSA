#include<iostream>
using namespace std;

int main() {
    int num; 
    cin >> num;

    if (num == 0) {
        cout << "the number is zero";
    }
    else if (num > 0) {
        if (num % 2 == 0) {
            cout << "the number is positive even";
        } else {
            cout << "the number is positive odd";
        }
    }
    else { // num < 0
        if (num % 2 == 0) {
            cout << "the number is negative even";
        } else {
            cout << "the number is negative odd";
        }
    }
}
